    "jquery",
    "html-form",
    "ajax-form",
    "json",
    "loadjson-plugin",
    "jquery-plugin"
  ],
  "authors": [
    {
      "name": "Kevin Morris"
    },
    {
      "name": "Jovan Popovic"
    }
  ],
  "homepage": "https://github.com/kevindb/jquery-load-json",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevindb/jquery-load-json.git"
  },
  "dependencies": {
    "jquery": ">=3.5"
  }
}
